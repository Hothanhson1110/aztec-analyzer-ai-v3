<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#00E5FF</item>
        <item name="colorPrimaryVariant">#087E9B</item>
        <item name="colorSecondary">#C45CFF</item>
        <item name="android:colorAccent">#00E5FF</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#070B18</item>
        <item name="android:statusBarColor">#070B18</item>
        <item name="android:navigationBarColor">#070B18</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">#E6EEFF</item>
        <item name="android:textColorSecondary">#9BAAC8</item>
        <item name="materialCardViewStyle">@style/AztecNeonCard</item>
        <item name="textInputStyle">@style/AztecNeonInput</item>
    </style>
    <style name="AztecNeonCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#111A2E</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">5dp</item>
        <item name="strokeColor">#263B66</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="AztecNeonInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">#00D9F5</item>
        <item name="hintTextColor">#8B9AB8</item>
    </style>
</resources>
